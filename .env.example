# Path to yt-dlp binary (optional if on PATH)
YTDLP_BIN=

# OpenAI API key (required for transcription & summarisation)
OPENAI_API_KEY=

# Transcription model (default: gpt-4o-mini-transcribe)
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Maximum allowed video duration in seconds (default: 1200 = 20 min)
MAX_VIDEO_DURATION_SEC=1200
